{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scopeforge.dev/schemas/protocol-v0.json",
  "title": "ScopeForge Protocol v0 (JSON-RPC 2.0 over NDJSON stdio)",
  "description": "Source of truth for codegen. Each line on stdio is one JSON-RPC 2.0 message.",
  "protocol_version": "0.1.0",
  "envelope": {
    "required": ["jsonrpc", "protocol_version", "trace_id", "ts"],
    "fields": {
      "jsonrpc": { "const": "2.0" },
      "protocol_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
      "trace_id": { "type": "string", "minLength": 8 },
      "ts": { "type": "string", "format": "date-time" },
      "run_id": { "type": "string" },
      "seq": { "type": "integer", "minimum": 0 },
      "redaction": { "enum": ["clean", "redacted", "sensitive-ref-only"], "default": "clean" }
    }
  },
  "methods": [
    { "name": "initialize", "params": ["protocol_version", "client"], "result": ["protocol_version", "engine", "capabilities"] },
    { "name": "capabilities", "params": [], "result": ["protocol", "methods", "events", "modes"] },
    { "name": "health", "params": [], "result": ["ok", "uptime_s", "queue_depth"] },
    { "name": "shutdown", "params": [], "result": ["ok"] },
    { "name": "run.create", "params": ["mode", "program"], "result": ["run_id", "mode", "status"] },
    { "name": "run.list", "params": [], "result": ["runs"] },
    { "name": "run.status", "params": ["run_id"], "result": ["run_id", "mode", "status", "budget"] },
    { "name": "run.cancel", "params": ["run_id"], "result": ["run_id", "cancelled"] },
    { "name": "run.close", "params": ["run_id"], "result": ["run_id", "closed"] },
    { "name": "event.subscribe", "params": ["count"], "result": [], "note": "test hook: emit N ordered token.delta events" },
    { "name": "tool.cancel", "params": ["tool_call_id"], "result": ["cancelled"] },
    { "name": "provider.list", "params": [], "result": ["providers"] },
    { "name": "model.list", "params": ["provider"], "result": ["provider", "models"] },
    { "name": "model.probe", "params": ["provider", "model"], "result": ["provider", "model", "capabilities"] },
    { "name": "case.create", "params": ["run_id", "case"], "result": ["case"] },
    { "name": "case.list", "params": ["run_id"], "result": ["cases"] },
    { "name": "case.show", "params": ["run_id", "case_id"], "result": ["case"] },
    { "name": "case.update", "params": ["run_id", "case_id", "fields"], "result": ["case"] },
    { "name": "artifact.import", "params": ["run_id"], "result": ["evidence_id", "sha256"] },
    { "name": "evidence.list", "params": ["run_id"], "result": ["evidence"] },
    { "name": "evidence.show", "params": ["run_id", "evidence_id"], "result": ["evidence"] },
    { "name": "evidence.redact", "params": ["run_id", "evidence_id"], "result": ["derived"] },
    { "name": "coverage.get", "params": ["run_id"], "result": ["coverage"] },
    { "name": "coverage.set", "params": ["run_id", "categories"], "result": ["coverage"] },
    { "name": "report.build", "params": ["run_id", "finding"], "result": ["finding_id", "path"] },
    { "name": "export.create", "params": ["run_id"], "result": ["path", "sha256"] },
    { "name": "run.rebuild", "params": [], "result": ["counts"] },
    { "name": "policy.import", "params": ["file"], "result": ["policy"] },
    { "name": "policy.check", "params": ["action"], "result": ["allowed", "reasons"] },
    { "name": "policy.status", "params": ["run_id"], "result": ["mode", "budgets"] },
    { "name": "scope.show", "params": ["run_id"], "result": ["engagement"] },
    { "name": "chat.submit", "params": ["run_id", "message"], "result": ["output", "gaps"] },
    { "name": "case.execute", "params": ["run_id", "case_id"], "result": ["proposal"] },
    { "name": "coach.score", "params": ["run_id", "case_id"], "result": ["scores"] },
    { "name": "coverage.report", "params": ["run_id"], "result": ["categories"] },
    { "name": "tool.preview", "params": ["run_id", "action"], "result": ["allowed", "reasons"] },
    { "name": "tool.execute", "params": ["run_id", "action"], "result": ["status"] },
    { "name": "approval.respond", "params": ["run_id", "scope"], "result": ["recorded"] },
    { "name": "lab.list", "params": [], "result": ["labs"] },
    { "name": "lab.launch", "params": ["lab"], "result": ["url"] },
    { "name": "lab.stop", "params": ["lab"], "result": ["stopped"] },
    { "name": "lab.reset", "params": ["lab"], "result": ["reset"] },
    { "name": "experiment.compare", "params": ["run_id", "baseline", "variant"], "result": ["diff"] },
    { "name": "evidence.diff", "params": ["run_id"], "result": ["diff"] },
    { "name": "mcp.add", "params": ["name", "command"], "result": ["name"] },
    { "name": "mcp.list", "params": [], "result": ["servers"] },
    { "name": "mcp.enable", "params": ["name"], "result": ["name"] },
    { "name": "mcp.disable", "params": ["name"], "result": ["name"] },
    { "name": "mcp.remove", "params": ["name"], "result": ["removed"] },
    { "name": "tool.list", "params": [], "result": ["tools"] },
    { "name": "tool.invoke", "params": ["name"], "result": ["tool"] },
    { "name": "har.import", "params": ["run_id"], "result": ["imported"] },
    { "name": "burp.import", "params": ["run_id"], "result": ["imported"] }
  ],
  "events": ["token.delta", "reasoning.summary", "warning", "error", "run.checkpointed", "budget.changed"],
  "errors": {
    "-32601": "Method not found",
    "-32602": "Invalid params (e.g. unknown run_id)",
    "-32000": "Engine error",
    "1001": "Incompatible major protocol version",
    "1002": "Cancelled",
    "1003": "Provider runtime unavailable (httpx/anyio); run `uv sync`"
  }
}
